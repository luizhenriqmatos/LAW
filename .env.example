# Copie para .env.local e preencha. Nunca coloque segredos no código.

# Supabase (projeto na região sa-east-1, São Paulo) — PENDENCIA P-015
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do app, usado nos links de convite (ex.: https://app.law.com.br)
NEXT_PUBLIC_SITE_URL=

# E-mail transacional (Resend) — PENDENCIA P-016
# Sem estas duas, o convite é criado, a tela avisa que o e-mail NÃO saiu e mostra o link para copiar.
RESEND_API_KEY=
EMAIL_REMETENTE=

# Job de captura de publicações (Prompt 2). Só no servidor; nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que a Vercel Cron manda em "Authorization: Bearer ..." para /api/cron/captura
CRON_SECRET=

# Chave pública do DataJud divulgada pelo CNJ em https://datajud-wiki.cnj.jus.br/api-publica/acesso
# (aceita em 09/11/2026). O CNJ pode trocar a qualquer momento: erro "chave_recusada" = atualizar aqui.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Só desenvolvimento: troca o DJEN pela fonte de EXEMPLO (dados fictícios, gravados com fonte = "exemplo").
# Ignorado em produção.
DJEN_USAR_EXEMPLOS=0

# Google Agenda (Prompt 5) e Google Drive (Prompt 6) usam o MESMO app OAuth — PENDENCIAS P-026 e P-033 (ativar a Drive API e o escopo drive.file). Credenciais OAuth criadas no Google Cloud Console (tipo "Aplicativo da Web").
# URI de redirecionamento autorizada: <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave que cifra os tokens do Google no banco: 32 bytes em base64. Gere com: openssl rand -base64 32
# Perder esta chave = todos precisam reconectar o Google. Nunca commitar. PENDENCIA P-029.
GOOGLE_TOKEN_KEY=

# IA (Prompt 9): resumo em linguagem simples do portal do cliente — PENDENCIA P-055.
# Sem a chave, o botão "Gerar resumo com IA" fica desligado e o advogado escreve o resumo à mão.
ANTHROPIC_API_KEY=
# Modelo do resumo (opcional; padrão: claude-haiku-5-5)
ANTHROPIC_MODEL_RESUMO=
# Modelo da assistente Lia (Prompt 11, usa ferramentas; opcional; padrão: claude-sonnet-5-5). Usa a mesma ANTHROPIC_API_KEY.
ANTHROPIC_MODEL_ASSISTENTE=

# Conectores (Prompt 12): servidor MCP em /api/mcp + OAuth 2.1. Também exigem NEXT_PUBLIC_SITE_URL (https) e SUPABASE_SERVICE_ROLE_KEY.
# Segredo JWT do projeto Supabase (Project Settings > API > JWT secret, chave HS256 "legada"). O servidor MCP assina com ele
# um JWT de 5 minutos DO PRÓPRIO USUÁRIO para que a RLS valha nas ferramentas. Só no servidor. PENDENCIA P-071.
SUPABASE_JWT_SECRET=

# WhatsApp (Prompt 13): recepcionista em /api/whatsapp. PENDENCIA P-076. Sem elas o webhook responde 503 e nada é enviado.
# Token permanente do usuário do sistema (Meta > Configurações do negócio). Só no servidor.
WHATSAPP_ACCESS_TOKEN=
# Segredo do aplicativo da Meta: confere a assinatura X-Hub-Signature-256 de cada mensagem recebida.
WHATSAPP_APP_SECRET=
# Texto qualquer que você inventa e digita também no painel da Meta ao cadastrar o webhook (verificação GET).
WHATSAPP_VERIFY_TOKEN=
# Versão da Graph API (opcional; padrão v21.0)
WHATSAPP_API_VERSION=
